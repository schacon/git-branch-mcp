{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(npm ls:*)",
      "Bash(npm install)",
      "Bash(mkdir:*)",
      "Bash(cargo check:*)",
      "Bash(rm:*)",
      "Bash(cargo:*)",
      "Bash(RUST_BACKTRACE=1 cargo test -- --nocapture)"
    ],
    "deny": []
  },
  "enableAllProjectMcpServers": false
}